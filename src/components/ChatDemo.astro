---
// Self-contained animated chat demo for FolderBot
---

<div class="chat-demo">
  <div class="chat-window">
    <div class="chat-header">
      <div class="chat-dots"><span></span><span></span><span></span></div>
      <span class="chat-title">FolderBot · Copilot Studio</span>
    </div>
    <div class="chat-body">

      <div class="msg user msg-1">
        <span class="bubble">Continue the Vendor Assessment from last week</span>
      </div>

      <div class="msg bot msg-2">
        <img src="/openmaja-logo.png" class="avatar" alt="FolderBot" />
        <span class="bubble">📂 Resuming session <code>20260525-VendorAssessment</code>…</span>
      </div>

      <div class="msg bot msg-3">
        <img src="/openmaja-logo.png" class="avatar" alt="FolderBot" />
        <div class="bubble">
          Session restored · Last active <strong>6 days ago</strong><br/>
          Active plan: Vendor shortlist — <strong>step 2 of 4 complete</strong><br/>
          You were reviewing the compliance checklist.
        </div>
      </div>

      <div class="msg user msg-4">
        <span class="bubble">What's left to do?</span>
      </div>

      <div class="msg bot msg-5">
        <img src="/openmaja-logo.png" class="avatar" alt="FolderBot" />
        <span class="bubble">Steps remaining: security review (3 vendors), final scoring matrix, executive summary. Starting the security review now…</span>
      </div>

      <div class="msg bot msg-6">
        <img src="/openmaja-logo.png" class="avatar" alt="FolderBot" />
        <div class="bubble">
          ✅ Security review complete.<br/>
          Saved to your OneDrive: <code>outputs/security-review.md</code> 📄
        </div>
      </div>

      <div class="msg user msg-7">
        <span class="bubble">Good. Rewrite it for exec audience — shorter, no technical jargon.</span>
      </div>

      <div class="msg bot msg-8">
        <img src="/openmaja-logo.png" class="avatar" alt="FolderBot" />
        <span class="bubble typewriter" id="tw-msg"></span>
      </div>

    </div>
  </div>
</div>

<script>
  const text = "Rewriting for exec audience… Done. Updated file saved to OneDrive: outputs/security-review.md";
  const el = document.getElementById('tw-msg');
  let i = 0;

  function type() {
    if (el && i < text.length) {
      el.textContent += text[i++];
      setTimeout(type, 28);
    }
  }

  // msg-8 appears at 8.5s, typewriter starts shortly after
  setTimeout(type, 8700);
</script>

<style>
  .chat-demo {
    margin: 2rem 0;
  }

  .chat-window {
    background: #fff;
    border: 1.5px solid var(--icy);
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(1,44,115,0.10);
    width: 100%;
    overflow: hidden;
  }

  .chat-header {
    background: var(--navy);
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .chat-dots {
    display: flex;
    gap: 5px;
  }

  .chat-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.25);
  }

  .chat-title {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.7);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .chat-body {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: #f4f8ff;
  }

  .msg {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    opacity: 0;
    transform: translateY(8px);
    animation: msg-in 0.35s ease forwards;
  }

  .msg.user { flex-direction: row-reverse; }

  .msg-1 { animation-delay: 0.4s; }
  .msg-2 { animation-delay: 1.2s; }
  .msg-3 { animation-delay: 2.0s; }
  .msg-4 { animation-delay: 3.1s; }
  .msg-5 { animation-delay: 3.9s; }
  .msg-6 { animation-delay: 5.6s; }
  .msg-7 { animation-delay: 7.0s; }
  .msg-8 { animation-delay: 8.5s; }

  @keyframes msg-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .bubble {
    display: inline-block;
    padding: 0.55rem 0.85rem;
    border-radius: 12px;
    font-size: 0.875rem;
    line-height: 1.55;
    max-width: 75%;
  }

  .user .bubble {
    background: var(--navy);
    color: #fff;
    border-bottom-right-radius: 3px;
  }

  .bot .bubble {
    background: var(--icy);
    color: var(--navy);
    border-bottom-left-radius: 3px;
  }

  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--icy);
    object-fit: contain;
    flex-shrink: 0;
    margin-top: 2px;
    padding: 3px;
  }

  .typewriter::after {
    content: '▌';
    animation: blink 0.75s step-end infinite;
    color: var(--blue);
    font-size: 0.8em;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .bubble code {
    background: rgba(1,44,115,0.12);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.82em;
    font-family: monospace;
  }
</style>
