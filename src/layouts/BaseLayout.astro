---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Open-source autonomous agent framework for Microsoft 365 environments.',
} = Astro.props;
const pageTitle = title === 'OpenMaja' ? 'OpenMaja' : `${title} | OpenMaja`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

  </head>
  <body>
    <header>
      <div class="container">
        <a href="/" class="brand">
          <img src="/openmaja-logo.png" alt="OpenMaja logo" class="brand-logo" />
          <span>OpenMaja</span>
        </a>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer>
      <div class="container">
        <a href="/legal/terms">Terms of Service</a>
        <a href="/legal/privacy">Privacy Policy</a>
        <a href="https://github.com/openmaja">GitHub</a>
      </div>
    </footer>
  </body>
</html>
